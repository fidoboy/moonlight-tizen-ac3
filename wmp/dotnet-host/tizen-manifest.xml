<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://tizen.org/ns/packages"
          api-version="6.0"
          package="org.moonlight.host"
          version="0.1.0">
    <profile name="tv"/>
    <service-application appid="MoonLightS.WmpService"
                        exec="MoonlightHost.dll"
                        type="dotnet"
                        api-version="8"
                        multiple="false"
                        nodisplay="true"
                        taskmanage="false"
                        on-boot="false"
                        auto-restart="false">
        <label>Moonlight WMP service</label>
        <metadata key="http://samsung.com/tv/metadata/background.execution.support" value="true"/>
        <background-category value="background-network"/>
    </service-application>
    <privileges>
        <privilege>http://tizen.org/privilege/internet</privilege>
        <privilege>http://tizen.org/privilege/network.get</privilege>
        <privilege>http://developer.samsung.com/privilege/esplay</privilege>
    </privileges>
</manifest>
