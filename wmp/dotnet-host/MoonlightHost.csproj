<Project Sdk="Tizen.NET.Sdk/1.1.6">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen80</TargetFramework>
    <AssemblyName>MoonlightHost</AssemblyName>
    <RootNamespace>MoonlightWmpHost</RootNamespace>
    <TizenNetPackageVersion>8.0.0.15631</TizenNetPackageVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EngineApi.cs" />
    <None Include="../../res/icon.png" Link="icon.png" />
    <None Include="lib/libmlengine.so" Link="res/lib/libmlengine.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('lib/libmlengine.so')" />
  </ItemGroup>
</Project>
