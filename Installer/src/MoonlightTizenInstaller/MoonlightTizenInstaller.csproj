<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == 'win-x64'">Assets/moonlight.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MoonlightTizenInstaller.Core/MoonlightTizenInstaller.Core.csproj" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <AvaloniaResource Include="Assets/moonlight-logo.png" />
    <AvaloniaResource Include="Assets/moonlight.ico" />
    <EmbeddedResource Include="Moonlight.wgt" Condition="Exists('Moonlight.wgt')">
      <LogicalName>Moonlight.wgt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Moonlight-ForceGM.wgt" Condition="Exists('Moonlight-ForceGM.wgt')">
      <LogicalName>Moonlight-ForceGM.wgt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
