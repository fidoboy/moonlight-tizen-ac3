<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MoonlightTizenInstaller.MainWindow" Width="820" Height="680" MinWidth="680" MinHeight="560" Background="#080D19" Foreground="#F5F8FF" Title="Moonlight Tizen Installer">
  <Grid>
    <Image Source="avares://MoonlightTizenInstaller/Assets/moonlight-logo.png" Width="660" Height="660" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-330,0,0,0" Opacity="0.075" IsHitTestVisible="False"/>
    <Grid RowDefinitions="Auto,*,Auto" Margin="34,26,34,26">
      <StackPanel Spacing="22">
        <Grid ColumnDefinitions="Auto,*"><Image Source="avares://MoonlightTizenInstaller/Assets/moonlight-logo.png" Width="38" Height="38" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="1"><TextBlock Text="MOONLIGHT TIZEN" FontSize="17" FontWeight="Bold"/><TextBlock Text="Instalador para Samsung TV" FontSize="11" Foreground="#ACBAD0"/></StackPanel></Grid>
        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Spacing="6"><Border Name="Step1Circle" Background="#78B8FF" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="#080D19" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Name="Step1Label" Text="Inicio" FontSize="11" Foreground="#F5F8FF"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="6"><Border Name="Step2Circle" Background="#26344B" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="#ACBAD0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Name="Step2Label" Text="Televisor" FontSize="11" Foreground="#718099"/></StackPanel>
          <StackPanel Grid.Column="2" Spacing="6"><Border Name="Step3Circle" Background="#26344B" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="#ACBAD0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Name="Step3Label" Text="Conexión" FontSize="11" Foreground="#718099"/></StackPanel>
          <StackPanel Grid.Column="3" Spacing="6"><Border Name="Step4Circle" Background="#26344B" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left"><TextBlock Text="4" Foreground="#ACBAD0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Name="Step4Label" Text="Certificado" FontSize="11" Foreground="#718099"/></StackPanel>
          <StackPanel Grid.Column="4" Spacing="6"><Border Name="Step5Circle" Background="#26344B" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left"><TextBlock Text="5" Foreground="#ACBAD0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Name="Step5Label" Text="Instalación" FontSize="11" Foreground="#718099"/></StackPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,30,0,24">
        <Border Name="Step1Page" IsVisible="True" Background="#101A2D" BorderBrush="#263650" BorderThickness="1" CornerRadius="18" Padding="30"><StackPanel VerticalAlignment="Center" Spacing="16"><TextBlock Text="Moonlight en tu televisor" FontSize="30" FontWeight="Bold"/><TextBlock Text="Instala Moonlight en tu Samsung TV en unos sencillos pasos." FontSize="16" Foreground="#ACBAD0" TextWrapping="Wrap"/><TextBlock Text="Buscaremos tu televisor y elegiremos automáticamente la vía de instalación disponible." FontSize="14" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Name="Step2Page" IsVisible="False" Background="#101A2D" BorderBrush="#263650" BorderThickness="1" CornerRadius="18" Padding="26"><StackPanel Spacing="16"><TextBlock Text="Buscando tu televisor" FontSize="24" FontWeight="Bold"/><StackPanel Name="TelevisionSearchingPanel" Spacing="10" IsVisible="True"><ProgressBar IsIndeterminate="True" Height="5"/><TextBlock Name="TelevisionSearchStatus" Text="Detectando televisores Samsung…" TextWrapping="Wrap"/></StackPanel><StackPanel Name="TelevisionSelectionPanel" Spacing="8" IsVisible="False"><TextBlock Name="TelevisionSelectionPrompt" Text="Selecciona el televisor:" TextWrapping="Wrap"/><ComboBox Name="TelevisionSelection" SelectionChanged="OnTelevisionSelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><TextBlock Name="TelevisionDiscoveryStatus" TextWrapping="Wrap" Foreground="#ACBAD0"/></StackPanel></Border>
        <Border Name="Step3Page" IsVisible="False" Background="#101A2D" BorderBrush="#263650" BorderThickness="1" CornerRadius="18" Padding="26"><StackPanel Spacing="14"><StackPanel Name="TvStoreHandoffPanel" Spacing="12" IsVisible="False"><TextBlock Text="Confirma la instalación en la TV" FontSize="24" FontWeight="Bold"/><TextBlock Name="TvStoreHandoffStatus" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="FinishTvStoreHandoffButton" Content="Finalizar" IsVisible="False"/><Button Name="ContinueWithSdbButton" Content="Usar instalación alternativa"/></StackPanel></StackPanel><StackPanel Name="TelevisionActivationPanel" Spacing="12" IsVisible="False"><TextBlock Text="Activa Developer Mode" FontSize="24" FontWeight="Bold"/><TextBlock Text="En la TV, abre Apps e introduce 12345 con el mando. Activa Developer Mode y configura Host PC IP con esta dirección:" TextWrapping="Wrap"/><Border Background="#14213A" BorderBrush="#344765" BorderThickness="1" CornerRadius="10" Padding="14"><TextBlock Name="HostIpAddress" Text="Consultando IP…" FontSize="24" FontWeight="Bold" Foreground="#78B8FF"/></Border><TextBlock Name="DeveloperModeHostIpDescription" TextWrapping="Wrap" Foreground="#ACBAD0"/><TextBlock Text="Guarda los cambios y reinicia la TV. Después, pulsa Siguiente para volver a intentarlo." TextWrapping="Wrap"/><Button Name="RetryTelevisionDiscoveryButton" Content="Reintentar detección" HorizontalAlignment="Left" Click="OnDiscoverTelevisionsClick"/></StackPanel></StackPanel></Border>
        <Border Name="Step4Page" IsVisible="False" Background="#101A2D" BorderBrush="#263650" BorderThickness="1" CornerRadius="18" Padding="26"><StackPanel Spacing="16"><TextBlock Text="Certificado Samsung" FontSize="24" FontWeight="Bold"/><TextBlock Text="Se necesita un certificado Partner para instalar mediante SDB. Si ya existe uno válido, se utilizará automáticamente." TextWrapping="Wrap" Foreground="#ACBAD0"/><Button Name="GenerateCertificateButton" Content="Crear o renovar certificado con Samsung" HorizontalAlignment="Left" IsEnabled="False" Click="OnGenerateCertificateClick"/><TextBlock Name="CertificateOperationStatus" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Name="Step5Page" IsVisible="False" Background="#101A2D" BorderBrush="#263650" BorderThickness="1" CornerRadius="18" Padding="26"><StackPanel Spacing="16"><TextBlock Text="Instalar Moonlight" FontSize="24" FontWeight="Bold"/><TextBlock Text="El paquete se firmará y se enviará al televisor mediante SDB." TextWrapping="Wrap" Foreground="#ACBAD0"/><Button Name="InstallWgtButton" Content="Instalar Moonlight" HorizontalAlignment="Left" IsEnabled="False" Click="OnInstallWgtClick"/><TextBlock Name="InstallationStatus" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><Button Content="Salir" IsCancel="True" HorizontalAlignment="Left" Background="#14213A" BorderBrush="#344765"/><Button Name="NextButton" Grid.Column="1" Content="Siguiente" IsDefault="True" MinWidth="132" Padding="22,11" Background="#78B8FF" Foreground="#080D19" FontWeight="Bold" Click="OnNextClick"/></Grid>
    </Grid>
  </Grid>
</Window>