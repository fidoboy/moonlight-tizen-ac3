<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoonlightTizenInstaller.MainWindow"
        Width="760" Height="680"
        MinWidth="640" MinHeight="560"
        Title="Moonlight Tizen Installer">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28">
    <StackPanel Spacing="6">
      <TextBlock Text="Moonlight para Samsung TV" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="Instalador guiado" Opacity="0.7" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,24">
      <StackPanel Spacing="14">
        <Border Padding="20" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="Conectar con el televisor" FontSize="19" />
            <TextBlock Text="El instalador intenta primero enviar Moonlight a TV-Store, si está disponible. Si esa vía no puede completar la instalación, continúa por SDB y obtiene automáticamente el DUID. Nunca se solicita introducir el DUID manualmente." TextWrapping="Wrap" />
            <StackPanel Name="TelevisionSearchingPanel" Spacing="8" IsVisible="True">
              <ProgressBar IsIndeterminate="True" Height="6" />
              <TextBlock Name="TelevisionSearchStatus" Text="Detectando televisores y comprobando primero la disponibilidad de TV-Store…" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Name="TvStoreHandoffPanel" Spacing="12" IsVisible="False">
              <TextBlock Text="Paquete entregado a TV-Store" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Name="TvStoreHandoffStatus" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="FinishTvStoreHandoffButton" Content="Finalizar" HorizontalAlignment="Left" />
                <Button Name="ContinueWithSdbButton" Content="Continuar mediante SDB" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
            <StackPanel Name="TelevisionActivationPanel" Spacing="10" IsVisible="False">
              <TextBlock Text="Activa Developer Mode para obtener el DUID" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="Esta es la vía alternativa de instalación directa. El DUID es obligatorio para preparar el certificado y continuar por SDB. El instalador nunca te pedirá que lo escribas manualmente. Comprueba que el televisor está encendido y conectado a la misma red local y sigue estos pasos para activar Developer Mode:" TextWrapping="Wrap" />
              <TextBlock Text="1. Enciende el televisor y abre la sección Apps." TextWrapping="Wrap" />
              <TextBlock Text="2. Con el mando a distancia, introduce la secuencia 12345 para abrir el menú de Developer Mode." TextWrapping="Wrap" />
              <TextBlock Text="3. Activa Developer Mode (ON)." TextWrapping="Wrap" />
              <TextBlock Name="DeveloperModeHostIpDescription" Text="4. En el campo Host PC IP, introduce exactamente esta dirección IP:" TextWrapping="Wrap" />
              <Border Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <TextBlock Name="HostIpAddress" Text="Consultando dirección IP…" FontSize="20" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="5. Confirma la configuración y reinicia el televisor si lo solicita. Comprueba que el ordenador y la TV están conectados a la misma red local." TextWrapping="Wrap" />
              <TextBlock Text="Cuando hayas terminado, pulsa Reintentar. Se repetirá la detección; primero se comprobará TV-Store y, si no puede utilizarse, se intentará obtener automáticamente el DUID por el relay SDB o por el puerto convencional." TextWrapping="Wrap" Opacity="0.8" />
              <Button Name="RetryTelevisionDiscoveryButton" Content="Reintentar" HorizontalAlignment="Left" Click="OnDiscoverTelevisionsClick" />
            </StackPanel>
            <StackPanel Name="TelevisionSelectionPanel" Spacing="8" IsVisible="False">
              <TextBlock Name="TelevisionSelectionPrompt" Text="Se han detectado varios televisores. Selecciona el que quieras utilizar:" TextWrapping="Wrap" />
              <ComboBox Name="TelevisionSelection" SelectionChanged="OnTelevisionSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Name="TelevisionDiscoveryStatus" TextWrapping="Wrap" Opacity="0.8" />
            <StackPanel Name="TelevisionActionsPanel" Spacing="8" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="GenerateCertificateButton" Content="Crear o renovar certificado con Samsung" HorizontalAlignment="Left" IsEnabled="False" Click="OnGenerateCertificateClick" />
                <Button Name="InstallWgtButton" Content="Instalar Moonlight mediante SDB" HorizontalAlignment="Left" IsEnabled="False" Click="OnInstallWgtClick" />
              </StackPanel>
              <TextBlock Text="Esta acción solo se habilita si la vía preferente de TV-Store no está disponible y se ha obtenido automáticamente un DUID válido. Si el relay de TV-Store está activo, se utiliza como transporte SDB; de lo contrario, se conecta al puerto SDB convencional." TextWrapping="Wrap" Opacity="0.7" />
              <TextBlock Name="CertificateOperationStatus" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Salir" IsCancel="True" />
      <Button Content="Siguiente" IsDefault="True" IsEnabled="False" />
    </StackPanel>
  </Grid>
</Window>