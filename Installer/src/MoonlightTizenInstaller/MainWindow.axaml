<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoonlightTizenInstaller.MainWindow"
        Width="760" Height="680"
        MinWidth="640" MinHeight="560"
        Title="Moonlight Tizen Installer">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28">
    <StackPanel Spacing="6">
      <TextBlock Text="Moonlight para Samsung TV" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="Instalador guiado" Opacity="0.7" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,24">
      <StackPanel Spacing="14">
        <Border Padding="20" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="Certificados de firma" FontSize="19" />
            <TextBlock Name="CertificateStatus" Text="Consultando perfiles…" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Recuperar certificados…" Click="OnImportCertificatesClick" />
              <Button Content="Exportar certificados…" Click="OnExportCertificatesClick" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Padding="20" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="Conectar con el televisor" FontSize="19" />
            <TextBlock Text="Los televisores Samsung se detectan por su API de red. Enviar Moonlight a Apps2Samsung TV-Store no requiere Developer Mode ni SDB. La conexión de desarrollo solo es necesaria para obtener el DUID, gestionar certificados y firmar localmente." TextWrapping="Wrap" />
            <StackPanel Name="TelevisionSearchingPanel" Spacing="8" IsVisible="True">
              <ProgressBar IsIndeterminate="True" Height="6" />
              <TextBlock Name="TelevisionSearchStatus" Text="Buscando televisores y comprobando la conexión SDB…" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Name="TelevisionActivationPanel" Spacing="10" IsVisible="False">
              <TextBlock Text="Comprueba la conexión con el televisor" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="La instalación mediante TV-Store no necesita Developer Mode. Comprueba primero que el televisor está encendido y conectado a la misma red local. Si quieres gestionar certificados o firmar el paquete localmente, activa Developer Mode siguiendo estos pasos:" TextWrapping="Wrap" />
              <TextBlock Text="1. Enciende el televisor y abre la sección Apps." TextWrapping="Wrap" />
              <TextBlock Text="2. Con el mando a distancia, introduce la secuencia 12345 para abrir el menú de Developer Mode." TextWrapping="Wrap" />
              <TextBlock Text="3. Activa Developer Mode (ON)." TextWrapping="Wrap" />
              <TextBlock Text="4. En el campo Host PC IP, introduce exactamente esta dirección IP:" TextWrapping="Wrap" />
              <Border Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <TextBlock Name="HostIpAddress" Text="Consultando dirección IP…" FontSize="20" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="5. Confirma la configuración y reinicia el televisor si lo solicita. Comprueba que el ordenador y la TV están conectados a la misma red local." TextWrapping="Wrap" />
              <TextBlock Text="Cuando hayas terminado, pulsa Reintentar. Se repetirá la detección de televisores y, si Developer Mode está activo, también se intentará leer el DUID." TextWrapping="Wrap" Opacity="0.8" />
              <Button Name="RetryTelevisionDiscoveryButton" Content="Reintentar" HorizontalAlignment="Left" Click="OnDiscoverTelevisionsClick" />
            </StackPanel>
            <StackPanel Name="TelevisionSelectionPanel" Spacing="8" IsVisible="False">
              <TextBlock Name="TelevisionSelectionPrompt" Text="Se han detectado varios televisores. Selecciona el que quieras utilizar:" TextWrapping="Wrap" />
              <ComboBox Name="TelevisionSelection" SelectionChanged="OnTelevisionSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Name="TelevisionDiscoveryStatus" TextWrapping="Wrap" Opacity="0.8" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="EnsureCertificateButton" Content="Preparar certificado" HorizontalAlignment="Left" IsEnabled="False" Click="OnEnsureCertificateClick" />
              <Button Name="SignWgtButton" Content="Firmar paquete incluido…" HorizontalAlignment="Left" IsEnabled="False" Click="OnSignWgtClick" />
              <Button Name="InstallWgtButton" Content="Enviar a TV-Store para instalar" HorizontalAlignment="Left" IsEnabled="False" Click="OnInstallWgtClick" />
            </StackPanel>
            <TextBlock Text="La instalación sin SDB utiliza Apps2Samsung TV-Store: el paquete se transfiere por red y debes confirmar «Instalar» en la pantalla del televisor. TV-Store debe estar instalado y tener un certificado de firma configurado." TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock Name="CertificateOperationStatus" TextWrapping="Wrap" Opacity="0.8" />
          </StackPanel>
        </Border>
        <TextBlock Text="Los materiales CA de Samsung/Tizen no se distribuyen con el instalador. La emisión requiere que estén instalados desde una fuente autorizada." TextWrapping="Wrap" Opacity="0.7" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Salir" IsCancel="True" />
      <Button Content="Siguiente" IsDefault="True" IsEnabled="False" />
    </StackPanel>
  </Grid>
</Window>